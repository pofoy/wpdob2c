# 时区
TZ=Asia/Shanghai

# 申请证书邮箱
CERTBOT_EMAIL=admin@example.com

# MySQL
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306

# B2C WordPress
WOOCOMMERCE_VERSION=10.9.4
OBJECT_CACHE_PLUGIN_VERSION=2.3.3
MEMCACHED_MEMORY_MB=256

# Shared JCM GeoIP service. Both values are required when the geoip profile is enabled.
# Keep the HMAC secret outside source control; use stable comma-separated project ids.
JCM_GEOIP_HMAC_SECRET=
JCM_GEOIP_ALLOWED_PROJECTS=
JCM_GEOIP_MAX_BATCH=100
JCM_GEOIP_MAX_REQUESTS_PER_MINUTE=600
JCM_GEOIP_CACHE_TTL_HOURS=168
JCM_GEOIP_CACHE_SIZE=20000

# Free DB-IP Lite database updates.
DBIP_UPDATE_INTERVAL_HOURS=720
