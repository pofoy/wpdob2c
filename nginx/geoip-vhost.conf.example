server {
    listen 80;
    listen [::]:80;
    server_name ip.dnooo.com;

    location ^~ /.well-known/acme-challenge/ {
        root /wwwroot/ip.dnooo.com;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ip.dnooo.com;

    ssl_certificate /letsencrypt/live/ip.dnooo.com/fullchain.pem;
    ssl_certificate_key /letsencrypt/live/ip.dnooo.com/privkey.pem;
    client_max_body_size 64k;

    location = /healthz {
        proxy_pass http://jcm-geoip:8080/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ^~ /v1/ {
        limit_except POST { deny all; }
        proxy_pass http://jcm-geoip:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 1s;
        proxy_read_timeout 3s;
        proxy_send_timeout 3s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
